# Wayfinder wrote this file when it created this repository.
#
# It holds the two values the workflow cannot read from anywhere else: which
# stack this repository deploys, and which `wf` build CI installs. Everything
# else CI needs — the Wayfinder server, the service account the deploy job signs
# in as, the environment it deploys to and the AWS region — is a GitHub variable
# Wayfinder set at the same time.

# Names the stack instance: <stack>-dev.
WF_STACK_NAME=${{ .Stack.Name }}

# The `wf` CLI build CI installs. Empty tracks the latest development build;
# set it to a released version (e.g. v3.3.2) to pin.
WF_CLI_VERSION=
